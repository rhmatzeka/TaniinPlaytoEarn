# Copy to .env (git-ignored). Values marked "public" may ship in the APK/web
# build; everything else stays on the server (Vercel env or srv).

# --- Public: chain and endpoints -------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TANIIN_COIN_CONTRACT_ADDRESS=0x8E1584fF95842C888F1FAaB29ed1e55d886A81F8
TANIIN_LAND_CONTRACT_ADDRESS=0x55D768D736b66B842EE72Ff7fa143f03245F81cc
TANIIN_ITEMS_CONTRACT_ADDRESS=0x9414eD4F6d9beF484484D72da3d8361989348AEf
# Game API origin for the APK. Web builds use their own origin when empty.
# Local USB device: http://127.0.0.1:8787 with `adb reverse tcp:8787 tcp:8787`.
TANIIN_GAME_API_URL=
# Always-on Socket.IO server (srv). Empty = multiplayer off, game stays solo.
TANIIN_MULTIPLAYER_URL=
# Privy app ID is public; it is baked into the /masuk login page at build time.
PRIVY_APP_ID=

# --- Server only -------------------------------------------------------------
PRIVY_APP_SECRET=
# Neon Postgres connection string (sessions, player state, audit log).
DATABASE_URL=
# Backend signer key. Owner of the Sepolia contracts. Never commit or ship it.
DEPLOYER_PRIVATE_KEY=
TANIIN_ALLOWED_ORIGIN=
TANIIN_GAME_API_PORT=8787

# Economy guards
TANIIN_ECONOMY_PAUSED=false
TANIIN_ETH_WEI_PER_COIN=10000000000000
TANIIN_MAX_ETH_PAYOUT_WEI=100000000000000000
TANIIN_DAILY_ETH_PAYOUT_WEI=10000000000000000
TANIIN_DAILY_TANI_MINT=2000
TANIIN_MIN_SIGNER_BALANCE_WEI=200000000000000000

# Pak Tani AI (optional). Without a key the AI uses a rule-based parser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Deploy tooling only
TANIIN_MINT_AMOUNT=1000
