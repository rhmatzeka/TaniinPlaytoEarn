SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Android reads these public addresses into BuildConfig. Leave blank until deployed.
TANIIN_COIN_CONTRACT_ADDRESS=
TANIIN_ITEMS_CONTRACT_ADDRESS=
TANIIN_LAND_CONTRACT_ADDRESS=

# Optional backend/signer endpoint for real transaction submission.
# Keep private keys on that backend or deploy machine, never in the Android app.
TANIIN_GAME_API_URL=

# Deploy tooling only. Do not commit a real key. Rotate any key that was pasted into chat.
DEPLOYER_PRIVATE_KEY=replace_with_new_private_key_do_not_commit
