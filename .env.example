SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Android reads these public addresses into BuildConfig. Leave blank until deployed.
TANIIN_COIN_CONTRACT_ADDRESS=
TANIIN_ITEMS_CONTRACT_ADDRESS=
TANIIN_LAND_CONTRACT_ADDRESS=

# Optional public wallet address for debug auto-connect. Never put a private key here.
# For ETH payout testing, use a player wallet that is different from the backend signer.
TANIIN_DEFAULT_WALLET_ADDRESS=

# Optional backend/signer endpoint for real transaction submission.
# Keep private keys on that backend or deploy machine, never in the Android app.
# For the local Node signer in contracts/scripts/game-api.cjs.
# Use 127.0.0.1 with `adb reverse tcp:8787 tcp:8787` on a USB device.
# Use 10.0.2.2 on an emulator without adb reverse.
# Use the computer LAN IP, for example http://192.168.1.9:8787, for WiFi ADB.
TANIIN_GAME_API_URL=http://127.0.0.1:8787
TANIIN_GAME_API_PORT=8787

# Optional native ETH swap payout settings for the backend signer.
# Android uses the same rate for display. Default: 10 gwei per game coin.
TANIIN_ETH_WEI_PER_COIN=10000000000
TANIIN_MAX_ETH_PAYOUT_WEI=10000000000000000

# Deploy tooling only. Do not commit a real key. Rotate any key that was pasted into chat.
DEPLOYER_PRIVATE_KEY=replace_with_new_private_key_do_not_commit

# Optional: Groq LLM key powers the AI Farmer Agent natural-language commands.
# Get one free at https://console.groq.com/keys. Without it, the agent uses a
# built-in rule-based parser. Keep this only on the backend, never in the app.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
