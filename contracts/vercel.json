{
  "buildCommand": "npm run build:masuk",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/main/(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|main.dart.wasm|main.dart.mjs|version.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/main/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache"
        }
      ]
    },
    {
      "source": "/main/canvaskit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/masuk/(chunk|masuk|login)-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/router?route=/health"
    },
    {
      "source": "/auth/privy",
      "destination": "/api/router?route=/auth/privy"
    },
    {
      "source": "/auth/code",
      "destination": "/api/router?route=/auth/code"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/router?route=/auth/logout"
    },
    {
      "source": "/player",
      "destination": "/api/router?route=/player"
    },
    {
      "source": "/player/import",
      "destination": "/api/router?route=/player/import"
    },
    {
      "source": "/game-actions",
      "destination": "/api/router?route=/game-actions"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/main",
      "destination": "/main/",
      "permanent": true
    },
    {
      "source": "/unduh",
      "destination": "https://github.com/rhmatzeka/TaniinPlaytoEarn/releases/download/apk-terbaru/Taniin.apk",
      "permanent": false
    },
    {
      "source": "/unduh/Taniin.apk",
      "destination": "https://github.com/rhmatzeka/TaniinPlaytoEarn/releases/download/apk-terbaru/Taniin.apk",
      "permanent": false
    }
  ]
}
