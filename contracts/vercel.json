{
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/flutter_bootstrap.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/main.dart.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/game-actions",
      "destination": "/api/game-actions"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/auth/nonce",
      "destination": "/api/auth-nonce"
    },
    {
      "source": "/auth/verify",
      "destination": "/api/auth-verify"
    },
    {
      "source": "/wallet-connect",
      "destination": "/api/wallet-connect"
    }
  ]
}
